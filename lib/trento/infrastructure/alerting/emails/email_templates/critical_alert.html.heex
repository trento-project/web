<EmailLayout.base_email>
  <p>Hi there,</p>
  <p>
    One of the components of the SAP environment currently monitored by Trento requires your attention:
  </p>
  <div>
    <p>
      Component: <b>{@component}</b>
      <br />
      {@identified_by}: <b>{@identifier}</b>
      <br /> Reason: <b>{@alerting_reason}</b>
    </p>
  </div>
  <p>
    Check the corresponding Details View in the Trento Console for remediation suggestions.
  </p>
  <p>Thanks for your attention.</p>
</EmailLayout.base_email>
